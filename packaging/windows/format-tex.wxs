<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for the LaTeX Coding Style Formatter (no admin prompt).

  Built with WiX v4+ (`wix build`), e.g.:
    wix build packaging/windows/format-tex.wxs -arch x64 \
        -d PayloadDir="<abs path>" -d Version="1.0.0" -o out.msi

  The payload directory must contain the GUI onedir bundle contents
  (format-tex-gui.exe + _internal/...) plus the CLI exe
  (format-tex.exe). WiX v4+ generates the components for <Files> and,
  with no explicit Feature, puts every component in the default feature.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="LaTeX Coding Style Formatter"
           Manufacturer="LaTeX Coding Style Formatter"
           Version="$(var.Version)"
           UpgradeCode="6f3b0c2a-5d84-4e17-9a3c-1f0e7b2d54c8"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="LaTeX Coding Style Formatter">
        <Files Include="$(var.PayloadDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="LaTeX Coding Style Formatter">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="GuiShortcut"
                    Name="LaTeX Coding Style Formatter"
                    Description="Format TeX files for Chinese journals"
                    Target="[INSTALLFOLDER]format-tex-gui.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder"
                        On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\LaTeX Coding Style Formatter"
                         Name="installed" Type="integer" Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
